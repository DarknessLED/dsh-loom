# The reference clones are research input, not part of the plugin.
research/gear/
research/open-dream-rsi/
node_modules/
*.log

# The survey cache is a build artifact: 97MB of search pages and paper HTML that
# a rerun re-fetches. What a survey *concluded* is checked in next to it.
research/out/.cache/

# The survey JSON is 16MB of parsed pages; the markdown next to it is the part a
# reader opens, and docs/research/<slug>-survey-<date>.md is the generated page.
research/out/*.survey.json

# A citation table is re-derived from the paper's own bibliography; the page a
# reader opens is docs/research/<slug>-<date>.md, which is checked in.
research/out/*.refs.json

# A deep read is re-derived from the paper's HTML; the body snapshots and the
# locator-carrying claims live in the ledger, and the page a reader opens is
# docs/research/deep-<slug>-<date>.md, which is checked in.
research/out/deep-*.json

# research scratch: the graph store is a build artifact, the sources are JSON
research/kg/store.sqlite
research/kg/store.sqlite-*
.kgbench/
scripts/_mutprobe*.mjs
research/wave9/src/

# UI screenshot scratch (local only; regenerate with scripts/panel-preview.mjs)
.oil-ui/
